      "id": "60a82d58-9f8a-4466-adbd-42486f175c66",
      "name": "Embeddings Google Gemini",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "credentials": {
        "googlePalmApi": {
          "id": "uZqwlnmrlVkD2oIq",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
