    {
      "parameters": {
        "errorMessage": "={{ $json.doc_id }}: extracted only {{ $json.text.length }} characters. Likely a scanned PDF with no text layer, or the wrong binary field. Not ingested."
      },
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        720,
        96
      ],
      "id": "57d787b7-dacb-41bf-a9da-bef99a408f63",
      "name": "Stop and Error"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  const meta = item.json;\n  const raw  = meta.text ?? '';\n\n  // ---- 1. Normalise what PDF extraction leaves behind -------------------\n  const text = raw\n    .replace(/\\r\\n?/g, '\\n')          // Windows line endings\n    .replace(/-\\n(?=[a-z])/g, '')     // re-join words split across lines\n    .replace(/\\u00A0/g, ' ')    // non-breaking spaces\n    .replace(/[ \\t]{2,}/g, '  ')      // collapse space runs, keep heading gap\n    .replace(/^\\s*Page \\d+ of \\d+\\s*$/gm, '')   // page furniture\n    .replace(/\\n{3,}/g, '\\n\\n')       // collapse blank-line runs\n    .trim();\n\n  if (text.length < 200) {\n    throw new Error(\n      `${meta.doc_id}: only ${text.length} characters after cleaning. Scanned PDF?`\n    );\n  }\n\n  // ---- 2. Find top-level headings: \"2  Annual Leave\" ---------------------\n  //    Deliberately strict. The line must be a number, whitespace, then a\n  //    short Capitalised phrase with no full stop. That refusal to match\n  //    sentences is what stops \"25 days of paid leave...\" becoming a heading.\n  const HEADING = /^(\\d{1,2})\\s+([A-Z][A-Za-z0-9 ,&\\/'-]{2,60})$/gm;\n  const marks   = [...text.matchAll(HEADING)];\n\n  // ---- 3. No headings? Fall back to one item for the whole document. ----\n  if (marks.length === 0) {\n    out.push({ json: buildItem(meta, text, '0', 'Full document', true) });\n    continue;\n  }\n\n  // ---- 4. One item per section ------------------------------------------\n  marks.forEach((m, i) => {\n    const start = m.index;\n    const end   = i + 1 < marks.length ? marks[i + 1].index : text.length;\n    const body  = text.slice(start, end).trim();\n    if (body.length < 40) return;   // a heading with no content under it\n    out.push({ json: buildItem(meta, body, m[1], m[2].trim(), false) });\n  });\n}\n\nfunction buildItem(meta, body, no, heading, isFallback) {\n  return {\n    document_id:    meta.doc_id,\n    title:          meta.title,\n    owner:          meta.owner,\n    version:        meta.version,\n    effective_date: meta.effective_date,\n    classification: meta.classification,\n    section_no:     no,\n    section_title:  heading,\n    citation:       `${meta.doc_id} §${no} (${meta.title} v${meta.version})`,\n    section_text:   body,\n    char_count:     body.length,\n    unsectioned:    isFallback,\n  };\n}\n\nreturn out;"
      },
